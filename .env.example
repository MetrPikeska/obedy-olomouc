# Supabase (Project Settings > API). Without these the app runs read-only from data/*.json
NEXT_PUBLIC_SUPABASE_URL=
# publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# only for scripts/push_supabase.py and the GitHub Action, never in the browser
# secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key (the secret goes to Supabase Auth > Bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_SITE_URL=https://obedy-olomouc.vercel.app
